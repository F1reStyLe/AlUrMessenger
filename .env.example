# Foundation: application, infrastructure, identity and admission settings.
# Export these variables before starting a binary; .env is not loaded implicitly.
APP_ENV=development
APP_SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=info
LOG_FORMAT=json

# When unset: API uses 127.0.0.1:8080, worker probes use 127.0.0.1:8081.
# Use a different HTTP_ADDR for each process if overriding it.
# HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=32768
HTTP_MAX_BODY_BYTES=67108864

# Image security ceilings. Project max_upload_size may reduce, never exceed, the global byte cap.
GLOBAL_MAX_UPLOAD_SIZE=52428800
IMAGE_MAX_DIMENSION=8192
IMAGE_MAX_PIXELS=16000000
IMAGE_DECODE_CONCURRENCY=2

# Required secrets: supply NAME or NAME_FILE, never both. No default credentials.
# URL passwords must be URL-encoded. Example file locations are operator-managed.
# POSTGRES_URL_FILE=/run/secrets/postgres_url
# REDIS_URL_FILE=/run/secrets/redis_url
# MINIO_ACCESS_KEY_FILE=/run/secrets/minio_access_key
# MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key
# Operator credentials: cmd/migrate, cmd/project, cmd/user-role and dev-only cmd/seed:
# MIGRATION_POSTGRES_URL_FILE=/run/secrets/migration_postgres_url
POSTGRES_MAX_CONNS=10
INFRA_TIMEOUT=5s
KAFKA_BROKERS=127.0.0.1:9092
# Production requires SASL_SSL with SCRAM-SHA-256 credentials:
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_USERNAME_FILE=/run/secrets/kafka_username
# KAFKA_PASSWORD_FILE=/run/secrets/kafka_password
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=chat-attachments
MINIO_REGION=us-east-1

# Production: PostgreSQL sslmode=verify-full, rediss, SASL_SSL and HTTPS MinIO.
# API: validate every bearer via Auth; only Chat DB determines application roles.
AUTH_MODE=remote
AUTH_BASE_URL=http://127.0.0.1:8080
AUTH_PROJECT_ID=00000000-0000-4000-8000-000000000001
# In Docker Desktop use http://host.docker.internal:8080 (Compose default).
# Production requires HTTPS; never reuse a Project with a different identity source.
# Offline fixtures only: AUTH_MODE=dev-rsa, public RSA PEM, no external revocation.
# AUTH_PUBLIC_KEY_FILE=.local/jwt-public.pem
# Required for API encrypted messages; generated by dev-init, never commit this file:
# CONTENT_KEYS_FILE=.local/content-keys.json
# Missing Origin is rejected by default, even for native clients:
WS_ALLOW_NO_ORIGIN=false
# CORS_ALLOWED_ORIGINS=https://demo.example.com,https://admin.example.com
# RATE_IP_PER_MINUTE=120
# RATE_USER_PER_MINUTE=60
