  "tags": [
    {
      "name": "Probes",
      "description": "Проверки процесса без JWT/API key. Readiness подтверждает четыре инфраструктурные зависимости."
    }
  ],
  "x-routing-errors": {
    "404": {
      "$ref": "#/components/responses/NotFound"
