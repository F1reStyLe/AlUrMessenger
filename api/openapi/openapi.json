  "components": {
    "headers": {
      "RequestID": {
        "description": "Принятый/нормализованный либо сгенерированный UUID; совпадает с error.request_id.",
        "schema": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "example": "01900000-0000-4000-8000-000000000001"
      }
    },
    "responses": {
      "Live": {
        "description": "Процесс отвечает независимо от готовности зависимостей.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Content-Type-Options": {
            "schema": {
              "type": "string",
              "const": "nosniff"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "const": "ok"
                }
              },
              "additionalProperties": false
            },
            "example": {
              "status": "ok"
            }
          }
        }
      },
      "Unavailable": {
        "description": "DEPENDENCY_UNAVAILABLE: PostgreSQL/schema, Redis, Kafka или MinIO недоступны, bucket отсутствует/имеет policy, проверка превысила deadline, либо процесс завершает работу. Конкретные адреса и причины в публичном ответе не раскрываются.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "X-Content-Type-Options": {
            "schema": {
              "type": "string",
              "const": "nosniff"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "DEPENDENCY_UNAVAILABLE",
                "message": "Service dependencies are unavailable",
                "request_id": "01900000-0000-4000-8000-000000000001"
              }
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "PAYLOAD_TOO_LARGE: Content-Length превышает HTTP_MAX_BODY_BYTES (default 1048576). Проверяется до routing/drain.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
