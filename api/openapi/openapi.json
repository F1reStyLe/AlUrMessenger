{
  "openapi": "3.1.0",
  "info": {
    "title": "Universal Chat Service",
    "version": "0.4.0",
    "description": "Foundation 1.4: infrastructure probes and Project-scoped identity API. JWT RS256: trusted Project issuer/audience, exp, sub, project_id, roles user/admin, token_use=access; 30s clock skew. First valid request atomically provisions a profile. Worker serves probes only. All responses use X-Request-ID and no-store. Swagger UI is scheduled for 1.6. Parser errors before application middleware may not use JSON envelopes."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API origin; worker supports only probes"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Probes"
        ],
        "operationId": "getLiveness",
        "summary": "Работоспособность процесса независимо от зависимостей",
        "description": "Авторизация не требуется. Ответ 200 означает, что процесс обслуживает HTTP. Liveness не проверяет инфраструктуру и остаётся доступной при drain, пока transport обслуживает соединение.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Live"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "head": {
        "tags": [
          "Probes"
        ],
        "operationId": "headLiveness",
        "summary": "Работоспособность процесса независимо от зависимостей",
        "description": "Авторизация не требуется. Ответ 200 означает, что процесс обслуживает HTTP. Liveness не проверяет инфраструктуру и остаётся доступной при drain, пока transport обслуживает соединение.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/HeadLive"
          },
          "413": {
            "$ref": "#/components/responses/HeadPayloadTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/HeadInternalError"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/RequestID"
        }
      ]
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Probes"
        ],
        "operationId": "getReadiness",
        "summary": "Готовность PostgreSQL/schema, Redis, Kafka и private MinIO",
        "description": "Без авторизации. Все четыре проверки должны пройти за общий deadline 1s. Успех — 200, недоступность/неверная schema/nonempty bucket policy/drain — 503. После закрытия listener соединение не устанавливается. Проба не создаёт данные и не заменяет проверки business permissions.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ready"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
        "tags": [
          "Probes"
        ],
        "operationId": "headReadiness",
        "summary": "Готовность PostgreSQL/schema, Redis, Kafka и private MinIO",
        "description": "Без авторизации. Все четыре проверки должны пройти за общий deadline 1s. Успех — 200, недоступность/неверная schema/nonempty bucket policy/drain — 503. После закрытия listener соединение не устанавливается. Проба не создаёт данные и не заменяет проверки business permissions.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/HeadReady"
          },
          "413": {
            "$ref": "#/components/responses/HeadPayloadTooLarge"
          },
          "500": {
            "$ref": "#/components/responses/HeadInternalError"
          },
          "503": {
            "$ref": "#/components/responses/HeadUnavailable"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/RequestID"
        }
      ]
    },
