    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "avatar_url",
          "kind",
          "status",
          "last_seen_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "avatar_url": {
            "type": "string",
            "description": "Empty or HTTPS avatar URL; server never fetches it."
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "bot",
              "system"
            ]
          },
          "status": {
            "type": "string",
            "example": "offline"
          },
          "last_seen_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Self": {
        "allOf": [
          {
            "$ref": "#/components/schemas/User"
          },
          {
            "type": "object",
            "required": [
              "external_user_id",
              "project_id",
              "roles"
            ],
            "properties": {
              "external_user_id": {
                "type": "string"
              },
              "project_id": {
                "type": "string",
                "format": "uuid"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "user",
                    "admin"
                  ]
                }
              }
            }
          }
        ]
      },
      "ProfilePatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "No leading/trailing whitespace or control characters."
          },
          "avatar_url": {
            "type": "string",
            "maxLength": 2048,
            "description": "Empty to clear; otherwise HTTPS URL without userinfo."
          }
        },
        "example": {
          "display_name": "Alice"
        }
      },
      "UserPage": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque cursor; null at end. Pass unchanged as cursor."
          }
        }
      }
    },
    "parameters": {
      "RequestID": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Correlation ID, не ключ авторизации или идемпотентности. Принимается UUID canonical layout, версии 1–8, RFC variant 8/9/a/b; uppercase нормализуется в lowercase. При другом значении, nil/max UUID или отсутствии заголовка генерируется UUID v4 без ошибки валидации.",
        "schema": {
          "type": "string"
        },
        "example": "01900000-0000-4000-8000-000000000001"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "External RS256 access JWT. Project comes exclusively from verified claims. Never pass tokens in URL."
      }
    }
  },
