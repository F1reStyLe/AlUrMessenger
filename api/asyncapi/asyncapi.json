{
  "asyncapi": "2.6.0",
  "info": {
    "title": "Universal Chat committed events",
    "version": "1.0.0",
    "description": "Phase 3–5.3 reference-only Kafka events; current message/relation/forward state is hydrated only by authorized HTTP/WS replay. Forward message.created never carries content, author snapshot or source conversation."
  },
  "defaultContentType": "application/json",
  "servers": {
    "development": {
      "url": "kafka:9092",
      "protocol": "kafka",
      "description": "Private development broker; production requires SASL/TLS."
    }
  },
  "channels": {
    "chat.events.v1": {
      "description": "Key=conversation_id, per-aggregate ordered publication, at-least-once. Consumers deduplicate event_id. No content/metadata/JWT.",
      "publish": {
        "operationId": "publishCommittedConversationEvent",
        "message": {
          "name": "ConversationEvent",
          "payload": {
            "type": "object",
            "required": [
              "event_id",
              "event_type",
              "event_version",
              "project_id",
              "aggregate_type",
              "aggregate_id",
              "aggregate_sequence",
              "occurred_at",
              "payload"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "format": "uuid"
              },
              "event_type": {
                "type": "string",
                "example": "message.created",
                "enum": [
                  "conversation.created",
                  "conversation.updated",
                  "conversation.members.added",
                  "conversation.member.updated",
                  "conversation.member.left",
                  "message.created",
                  "message.read",
                  "message.delivered",
                  "message.updated",
                  "message.deleted",
                  "reaction.created",
                  "reaction.deleted",
                  "message.pinned",
                  "message.unpinned"
                ]
              },
              "event_version": {
                "type": "integer",
                "const": 1
              },
              "project_id": {
                "type": "string",
                "format": "uuid"
              },
              "aggregate_type": {
                "type": "string",
                "const": "conversation"
              },
              "aggregate_id": {
                "type": "string",
                "format": "uuid"
              },
              "aggregate_sequence": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "example": "0"
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              },
              "payload": {
                "type": "object",
                "description": "References only. Message and relation mutations carry message_id, message_sequence, resource_version. No body, reaction deltas or pin snapshots are persisted in events. Authorized HTTP/WS replay adds current Message/reactions/pin; Kafka consumers needing state must use an authorized read API."
              }
            }
          }
        }
      }
    }
  }
}
